rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in parent can read and write only their own profile document.
    match /parents/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied until its access model is designed
    // (child profiles, reading activity, stories — see PROJECT_CONTEXT.md).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
